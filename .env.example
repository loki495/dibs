APP_NAME=Dibs
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8095

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Set to true when Dibs is served over HTTPS (e.g. behind a reverse proxy); leave blank for plain http.
SESSION_SECURE_COOKIE=
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
# Behind a reverse proxy, list its address(es) as IPs or CIDR ranges, comma-separated, e.g. the
# Docker network it reaches Dibs through:
#   docker network inspect <network> --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Getting this wrong doesn't error -- it silently renders asset URLs as http:// on an
# https:// page, which the browser blocks as mixed content (page loads, CSS/JS don't).
# Leave blank when nothing proxies Dibs.
TRUSTED_PROXIES=
DIBS_TIMEZONE=UTC
# Leave both blank to run local-only (no GitHub mirror); see README "Connecting to GitHub".
DIBS_GITHUB_OWNER=
DIBS_GITHUB_REPO=
GITHUB_TOKEN=

# Optional: where todo_report_bug files agent-reported tooling issues. Leave unset to file
# them unparented (the default).
DIBS_AGENT_REPORT_AREA_ID=
DIBS_AGENT_REPORT_GROUP_ID=
DIBS_AGENT_REPORT_PARENT_ID=

# Show the push-queue page and pending-sync badges in the UI
DIBS_PUSH_QUEUE_UI_ENABLED=true

# Seconds before a stuck Livewire request is abandoned and the reconnect banner shows (0 = no timeout)
DIBS_LIVEWIRE_REQUEST_TIMEOUT=20

# Milliseconds a request or navigation must take before the loading bar shows (avoids flicker on fast ones)
DIBS_LOADING_INDICATOR_DELAY_MS=150

# Activity log retention in days for the MCP call log and the change log (0 = keep forever),
# and the largest value stored per logged argument/field before it is truncated.
DIBS_ACTIVITY_MCP_RETENTION_DAYS=30
DIBS_ACTIVITY_CHANGE_RETENTION_DAYS=30
DIBS_ACTIVITY_MAX_VALUE_BYTES=2048

# Push-queue retry budget for transient GitHub failures: attempts before a row needs attention,
# and the exponential backoff's first delay and cap in seconds (rate limits wait for GitHub's time).
DIBS_PUSH_MAX_ATTEMPTS=8
DIBS_PUSH_BACKOFF_BASE_SECONDS=30
DIBS_PUSH_BACKOFF_CAP_SECONDS=3600

# Whether this process can check claim liveness through the host's /proc. Leave unset here:
# docker-compose.yml sets it false only for the web service, which has no host PID namespace.
# DIBS_PROCESS_LIVENESS=true

# How often (seconds) the app container's dibs:claims:watch loop records each live claim's process
# liveness for the web UI, and how old a recording may get before the UI treats it as unknown.
# DIBS_CLAIM_LIVENESS_INTERVAL=30
# DIBS_CLAIM_LIVENESS_STALE_AFTER=90

# Comma-separated GitHub Projects (v2) numbers to sync as areas, e.g. 1,2. Blank syncs none.
GITHUB_PROJECT_NUMBERS=
DB_QUEUE_RETRY_AFTER=960

# Demo mode -- off by default, only for the public demo deployment (see
# docker/Dockerfile.prod, docker-compose.prod.yml, docs/demo-hosting.md).
# DIBS_DEMO_MODE=true
# DEMO_DB_TEMPLATE_PATH=
# DEMO_DB_STORAGE_PATH=
# Optional, any deployment: auto-login for the owner. AUTO_LOGIN_EMAIL is an existing account to sign in as (demo
# mode defaults to the demo account). AUTO_LOGIN_LAN=true signs it in for requests that never touched Cloudflare and
# come from a private IP (only enable if nothing but Cloudflare and your LAN can reach the app, and behind a reverse proxy
# set TRUSTED_PROXIES first, or every proxied request counts as LAN; see README "Owner auto-login"); AUTO_LOGIN_OWNER_EMAIL
# does the same when Cloudflare Access asserts that email. All off by default.
# AUTO_LOGIN_EMAIL=
# AUTO_LOGIN_LAN=true
# AUTO_LOGIN_OWNER_EMAIL=
