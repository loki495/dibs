{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "loki495/dibs",
    "type": "project",
    "description": "A todo list app that's MCP-native, so AI agents can claim, coordinate on, and complete tasks alongside you. Backed by GitHub Issues and Projects as an asynchronous mirror.",
    "keywords": [
        "laravel",
        "framework",
        "mcp",
        "todo"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "fakerphp/faker": "^1.23",
        "laravel/framework": "^13.17",
        "laravel/mcp": "^1.0",
        "laravel/tinker": "^3.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "bash docker/setup.sh"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "pest": "docker compose exec -T -e PAO_FORCE=true -u www-data app vendor/bin/pest",
        "pint": "docker compose exec -T -e PAO_FORCE=true -u www-data app vendor/bin/pint --format=agent",
        "phpstan": "docker compose exec -T -e PAO_FORCE=true -u www-data app vendor/bin/phpstan analyse --memory-limit=512M",
        "rector": "docker compose exec -T -e PAO_FORCE=true -u www-data app vendor/bin/rector process --dry-run",
        "artisan": "docker compose exec -T -e PAO_FORCE=true -u www-data app php artisan",
        "pest:browser": "docker compose --profile test run --rm app-test vendor/bin/pest tests/Browser"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
