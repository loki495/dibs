# Public demo instance (docker-compose.demo.yml). Copy to .env.demo and fill in APP_KEY.
# Every value that matters for safety is set explicitly here, deliberately not left to fall
# through to the real .env this directory also contains -- see docs/demo-hosting.md.

APP_NAME="Dibs Demo"
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=https://dibs-demo.ac495.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=error

# Pre-visitor fallback only -- ResolveDemoDatabase repoints every real request at that
# visitor's own private copy before any query runs. Deliberately NOT database/database.sqlite
# (the real personal database this directory also contains) or database/demo.sqlite (this
# design's earlier shared-database iteration) -- a harmless, dedicated, always-empty path.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/demo-dbs/_fallback.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# No real GitHub sync from the demo, ever -- explicit even though these already default empty,
# so a copy-paste from the real .env can't accidentally carry a credential across.
GITHUB_TOKEN=
DIBS_GITHUB_OWNER=
DIBS_GITHUB_REPO=

DIBS_DEMO_MODE=true
DEMO_DB_TEMPLATE_PATH=/var/www/html/storage/demo-template.sqlite
DEMO_DB_STORAGE_PATH=/var/www/html/storage/demo-dbs
